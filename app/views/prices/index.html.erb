<% content_for :title, "Live Prices · Gold & Silver News" %>
<%# Refresh by "morphing": only changed parts of the page are updated. %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div data-controller="auto-refresh" data-auto-refresh-interval-value="5000">
  <h1>Live Prices</h1>

  <% if @stale %>
    <p class="flash flash--alert">Live prices are delayed. Showing the last price received.</p>
  <% end %>

  <div class="market">
    <% PriceQuote::METALS.each do |metal| %>
      <% quote = @latest[metal] %>
      <section class="market__half market__half--<%= metal %>" id="card_<%= metal %>">
        <header class="market__header">
          <h2><%= metal.capitalize %></h2>
          <span class="market__unit">per troy ounce</span>
        </header>

        <div class="market__body">
          <% if quote %>
            <% previous = quote.previous %>
            <p class="quote">
              <span class="quote__label">INR</span>
              <span class="price__value"><%= inr(quote.price_inr) %></span>
              <%= price_change(quote.price_inr, previous&.price_inr, currency: :inr) %>
            </p>
            <p class="quote quote--secondary">
              <span class="quote__label">USD</span>
              <span class="price__value"><%= usd(quote.price_usd) %></span>
              <%= price_change(quote.price_usd, previous&.price_usd) %>
            </p>
          <% else %>
            <p class="muted">Waiting for the first live price…</p>
          <% end %>

          <%= link_to "Buy #{metal.capitalize} on Binance ↗", BinancePriceSource.trade_url(metal),
                class: "button button--buy button--#{metal}",
                target: "_blank", rel: "noopener noreferrer" %>
          <p class="risk-note">Opens Binance <%= BinancePriceSource::SYMBOLS[metal] %> · leveraged futures, high risk</p>
        </div>
      </section>
    <% end %>
  </div>

  <% if @updated_at %>
    <p class="updated muted">
      Updated <%= @updated_at.strftime("%d %b %Y, %H:%M:%S") %> IST
      · Prices: Binance XAUUSDT / XAGUSDT
      · 1 USD = <%= inr(@usd_inr_rate, precision: 4) %> (ECB via Frankfurter)
    </p>
  <% end %>
</div>
