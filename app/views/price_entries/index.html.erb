<% content_for :title, "Manage Prices" %>

<h1>Manage Prices</h1>
<p class="muted">The ticker publishes these prices in order, one every 10 seconds, and loops back to the first.</p>

<section class="card">
  <h2>Add a price</h2>
  <%= form_with model: @price_entry, class: "entry-form" do |f| %>
    <% if @price_entry.errors.any? %>
      <div class="errors">
        <ul>
          <% @price_entry.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :metal %>
      <%= f.select :metal, PriceEntry::METALS.map { |m| [ m.capitalize, m ] } %>
    </div>
    <div class="field">
      <%= f.label :price_inr, "Price (₹)" %>
      <%= f.number_field :price_inr, step: 0.01, min: 0.01, required: true %>
    </div>
    <div class="field">
      <%= f.label :price_usd, "Price ($)" %>
      <%= f.number_field :price_usd, step: 0.01, min: 0.01, required: true %>
    </div>
    <%= f.submit "Add price", class: "button" %>
  <% end %>
</section>

<div class="cards">
  <% PriceEntry::METALS.each do |metal| %>
    <section class="card card--<%= metal %>" id="entries_<%= metal %>">
      <h2><%= metal.capitalize %> list</h2>
      <% entries = @entries.fetch(metal, []) %>
      <% if entries.any? %>
        <ol class="entry-list">
          <% entries.each do |entry| %>
            <li>
              <span><%= inr(entry.price_inr) %> · <%= usd(entry.price_usd) %></span>
              <%= button_to "Remove", price_entry_path(entry), method: :delete,
                    class: "button button--small",
                    form: { data: { turbo_confirm: "Remove this price?" } } %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="muted">No <%= metal %> prices yet.</p>
      <% end %>
    </section>
  <% end %>
</div>
