<% content_for :title, "Gold & Silver News" %>

<section class="hero">
  <p class="hero__eyebrow">Live · INR &amp; USD</p>
  <h1 class="hero__title">Gold &amp; Silver prices, at a glance</h1>
  <p class="hero__lead">
    Live gold and silver prices in rupees and US dollars,
    updating every few seconds like a broker's ticker.
  </p>
  <div class="hero__actions">
    <%= link_to "View live prices", prices_path, class: "button button--primary button--large" %>
    <%= link_to "▲▼ Start Binary Trading", trading_path, class: "button button--outline button--large" %>
  </div>
</section>

<section class="features">
  <div class="feature feature--gold">
    <h2>Gold</h2>
    <p>Live price per ounce in ₹ and $, with the change since the last update.</p>
  </div>
  <div class="feature feature--silver">
    <h2>Silver</h2>
    <p>Follow silver right next to gold, with green and red arrows showing which way it's moving.</p>
  </div>
</section>
